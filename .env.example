PUBLIC_SITE_URL=https://mittpsyke.se
PUBLIC_GA_MEASUREMENT_ID=
HIBP_API_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Dedikerad serverhemlighet för IP-hash och formulärtokens i anonyma berättelser.
# Obligatorisk och minst 32 tecken. Dela den inte med service-role eller andra salt.
# Utan ett giltigt värde nekas berättelseinlämning med ett generiskt serverfel.
STORY_RATE_LIMIT_SALT=
# Kommaseparerade user-id:n som får adminbehörighet (/admin, /admin/stories,
# /admin/radar). Serverkontrollerad källa - sätts i Render, aldrig av användaren.
ADMIN_USER_IDS=
# Dedikerat salt för pseudonymiseringen av user_ref i product_funnel_events.
# Krävs för att trattmätningen ska skriva något alls - utan den hoppas eventen
# över (dagboken påverkas inte). Egen hemlighet, delas medvetet inte med
# SUPABASE_SERVICE_ROLE_KEY: user_ref är nyckeln i unique(user_ref, event_name),
# så ett byte nollställer idempotensen och kopplar loss historiska rader från
# nya. Rotera bara medvetet, och räkna då med att mätserien börjar om.
FUNNEL_USER_REF_SALT=
# Prospektiv startpunkt för W1/W4-kohorten, i ISO 8601 med tidszon.
# Exempel: 2026-09-22T00:00:00Z. Konton skapade före startpunkten mäts inte.
# Saknat, ogiltigt eller orimligt framtida värde stänger retentionmätningen,
# utan att påverka dagbok, chatt eller kvällsincheckning.
RETENTION_COHORT_START=
