{
	"version": 3,
	"routes": [
		{
			"src": ".*",
			"continue": true,
			"transforms": [
				{
					"type": "request.query",
					"op": "delete",
					"target": {
						"key": "__pathname"
					}
				}
			]
		},
		{
			"src": "/_app/immutable/.+",
			"headers": {
				"cache-control": "public, immutable, max-age=31536000"
			}
		},
		{
			"handle": "filesystem"
		},
		{
			"src": "/_app/immutable/.+",
			"status": 404,
			"continue": false
		},
		{
			"src": "^/?(?:/__data.json)?$",
			"dest": "/"
		},
		{
			"src": "^/ansvar/?(?:/__data.json)?$",
			"dest": "/ansvar"
		},
		{
			"src": "^/api/chat/?(?:/__data.json)?$",
			"dest": "/api/chat"
		},
		{
			"src": "^/api/diary/create/?(?:/__data.json)?$",
			"dest": "/api/diary/create"
		},
		{
			"src": "^/api/diary/delete/?(?:/__data.json)?$",
			"dest": "/api/diary/delete"
		},
		{
			"src": "^/api/diary/stats-timeline/?(?:/__data.json)?$",
			"dest": "/api/diary/stats-timeline"
		},
		{
			"src": "^/api/diary/update/?(?:/__data.json)?$",
			"dest": "/api/diary/update"
		},
		{
			"src": "^/chat/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/chat/[category]"
		},
		{
			"src": "^/dagbok/?(?:/__data.json)?$",
			"dest": "/dagbok"
		},
		{
			"src": "^/dashboard/?(?:/__data.json)?$",
			"dest": "/dashboard"
		},
		{
			"src": "^/dashboard/installningar/?(?:/__data.json)?$",
			"dest": "/dashboard/installningar"
		},
		{
			"src": "^/integritet/?(?:/__data.json)?$",
			"dest": "/integritet"
		},
		{
			"src": "^/login/?(?:/__data.json)?$",
			"dest": "/login"
		},
		{
			"src": "^/om-mittpsyke/?(?:/__data.json)?$",
			"dest": "/om-mittpsyke"
		},
		{
			"src": "^/portal/([^/]+?)/?(?:/__data.json)?$",
			"dest": "/portal/[slug]"
		},
		{
			"src": "^/register/?(?:/__data.json)?$",
			"dest": "/register"
		},
		{
			"src": "/.*",
			"dest": "/![-]/catchall"
		}
	],
	"overrides": {}
}